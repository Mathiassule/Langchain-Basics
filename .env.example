# ==============================================================================
# LangChain Q&A Assistant - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env`:
#    Windows PowerShell: Copy-Item .env.example .env
#    macOS/Linux:        cp .env.example .env
# 2. Replace the placeholder below with your real OpenAI API key.
# 3. NEVER commit your actual `.env` file to version control.
# ==============================================================================

# Required: OpenAI API Key (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Model selection (defaults to gpt-4o-mini if not specified)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: Generation temperature (0.0 = deterministic, 1.0 = creative; default: 0.7)
TEMPERATURE=0.7

# Optional: Maximum conversation history turns to retain (default: 5)
MAX_HISTORY_TURNS=5
